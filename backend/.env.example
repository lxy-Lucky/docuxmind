# Which LLM provider to use by default: mimo | lmstudio
LLM_PROVIDER=mimo

# Cloud (mimo / xiaomimimo) — base URL & API key
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.5-pro

# Local LM Studio (OpenAI-compatible) — defaults match LM Studio out of the box
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=qwen2.5-7b-instruct

# Storage
DATA_DIR=./data
MAX_UPLOAD_MB=50

# Agent safety caps
AGENT_MAX_STEPS=20
AGENT_TOTAL_TOKEN_LIMIT=60000
AGENT_STEP_TIMEOUT_SEC=60

# Server
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
